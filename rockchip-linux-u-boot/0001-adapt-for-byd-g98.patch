From 8e4eccce069d533f8308f3b1571c19fc933bd68e Mon Sep 17 00:00:00 2001
From: yifengyou <842056007@qq.com>
Date: Fri, 31 Jul 2026 15:22:00 +0800
Subject: [PATCH] adapt for byd g98

Signed-off-by: yifengyou <842056007@qq.com>

diff --git a/.gitignore b/.gitignore
index f72f3a2fd4..bc98ef09f0 100644
--- a/.gitignore
+++ b/.gitignore
@@ -87,3 +87,10 @@ GTAGS
 *.orig
 *~
 \#*#
+bl31_0x00040000.bin.digest
+bl31_0x00040000.bin.gz
+examples/standalone/rkspi
+go.sh
+tee.bin.digest
+tee.bin.gz
+
diff --git a/arch/arm/dts/rk3588-evb.dts b/arch/arm/dts/rk3588-evb.dts
index ad750d5b74..ba9544e0a2 100644
--- a/arch/arm/dts/rk3588-evb.dts
+++ b/arch/arm/dts/rk3588-evb.dts
@@ -10,7 +10,7 @@
 #include <dt-bindings/input/input.h>
 
 / {
-	model = "Rockchip RK3588 Evaluation Board";
+	model = "BYD G98";
 	compatible = "rockchip,rk3588-evb", "rockchip,rk3588";
 
 	adc-keys {
@@ -28,4 +28,449 @@
 			press-threshold-microvolt = <1750>;
 		};
 	};
+
+	// vcc5v0_sys
+	vcc5v0_sys: vcc5v0-sys {
+		compatible = "regulator-fixed";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-name = "vcc5v0_sys";
+		vin-supply = <&vcc12v_dcin>;
+		u-boot,dm-pre-reloc;
+	};
+
+	// vcc12v_dcin
+	vcc12v_dcin: vcc12v-dcin {
+		compatible = "regulator-fixed";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <12000000>;
+		regulator-max-microvolt = <12000000>;
+		regulator-name = "vcc12v_dcin";
+		u-boot,dm-pre-reloc;
+	};
+
+	// vcc3v3-pcie30
+	vcc3v3_nvme: vcc3v3-nvme {
+		compatible = "regulator-fixed";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-name = "vcc3v3_nvme";
+		vin-supply = <&vcc12v_dcin>;
+		enable-active-high;
+		gpios = <&gpio3 RK_PD5 GPIO_ACTIVE_HIGH>;
+		startup-delay-us = <7500>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&nvme_power_en>;
+		u-boot,dm-pre-reloc;
+	};
+
+	// vcc5v0-host-regulator
+	vcc5v0_host_regulator: vcc5v0-host-regulator {
+		compatible = "regulator-fixed";
+		enable-active-high;
+		gpio = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&vcc5v0_host_en>;
+		regulator-name = "vcc5v0_host";
+		regulator-boot-on;
+		regulator-always-on;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		vin-supply = <&vcc5v0_sys>;
+		u-boot,dm-pre-reloc;
+	};
+
+	// vcc5v0-otg-regulator
+	vcc5v0_otg_regulator: vcc5v0-otg-regulator {
+		compatible = "regulator-fixed";
+		enable-active-high;
+		gpio = <&gpio4 RK_PA7 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&vcc5v0_otg_en>;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-name = "vcc5v0_otg";
+		vin-supply = <&vcc5v0_sys>;
+		u-boot,dm-pre-reloc;
+	};
+
+	leds {
+		compatible = "gpio-leds";
+		status = "okay";
+		u-boot,dm-pre-reloc;
+
+		hdd-led {
+			default-state = "off";
+			gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;
+		};
+
+		net-led {
+			default-state = "off";
+			gpios = <&gpio3 RK_PC0 GPIO_ACTIVE_HIGH>;
+		};
+
+		work-led {
+			gpios = <&gpio3 RK_PB7 GPIO_ACTIVE_HIGH>;
+			linux,default-trigger = "heartbeat";
+		};
+	};
+};
+
+/* ===== 关键修复：强制激活 GPIO 控制器 ===== */
+/* gpio3: gpio@fec40000 */
+&gpio3 {
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+/* gpio4: gpio@fec50000 */
+&gpio4 {
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+/* ===== Pin Control ===== */
+&pinctrl {
+	u-boot,dm-pre-reloc;
+	hym8563 {
+		hym8563_int: hym8563-int {
+			rockchip,pins = <0 RK_PB2 RK_FUNC_GPIO &pcfg_pull_up>;
+		};
+	};
+
+	pcie {
+		pcie2_0_rst: pcie2-0-rst {
+			rockchip,pins = <1 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		pcie2_1_rst: pcie2-1-rst {
+			rockchip,pins = <4 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		pcie3x2_rst: pcie3x2-rst {
+			rockchip,pins = <3 RK_PD4 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		pcie3x4_rst: pcie3x4-rst {
+			rockchip,pins = <4 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	nvme {
+		nvme_power_en: nvme-power-en {
+			rockchip,pins = <3 RK_PD5 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	usb {
+		vcc5v0_host_en: vcc5v0-host-en {
+			rockchip,pins = <4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+
+		vcc5v0_otg_en: vcc5v0-otg-en {
+			rockchip,pins = <4 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
+		};
+	};
+
+	sata {
+		sata0_pm_reset: sata0-pm-reset {
+			rockchip,pins = <0 RK_PD5 RK_FUNC_GPIO &pcfg_output_high>;
+		};
+	};
+};
+
+/* PCIe 3.0 x4 对应的 PHY */
+/* RK3588 PCIe 3.0 x4 和 x2 共用此 PHY */
+&pcie30phy {
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+&pcie3x2 {
+	status = "disabled";  /* 不要设为 okay！未接设备的端口会导致枚举异常 */
+};
+
+// pcie3x2: pcie@fe160000
+/*
+&pcie3x2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcie3x2_rst>;
+	num-lanes = <2>;
+	reset-gpios = <&gpio3 RK_PD4 GPIO_ACTIVE_HIGH>;
+	vpcie3v3-supply = <&vcc3v3_nvme>;
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+ */
+
+// pcie3x4: pcie@fe150000
+&pcie3x4 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcie3x4_rst>;
+	num-lanes = <2>;
+	reset-gpios = <&gpio4 RK_PB6 GPIO_ACTIVE_HIGH>;
+	vpcie3v3-supply = <&vcc3v3_nvme>;
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+// gmac0: ethernet@fe1b0000
+&gmac0 {
+	clock_in_out = "output";
+	phy-mode = "rgmii-rxid";
+	tx_delay = <0x44>;
+	pinctrl-0 = <&gmac0_miim &gmac0_tx_bus2 &gmac0_rx_bus2 &gmac0_rgmii_clk &gmac0_rgmii_bus>;
+	pinctrl-names = "default";
+	snps,reset-active-low;
+	snps,reset-delays-us = <0x00 0x4e20 0x186a0>;
+	snps,reset-gpio = <&gpio3 RK_PD0 GPIO_ACTIVE_LOW>;
+	status = "okay";
+	u-boot,dm-pre-reloc;
+
+	fixed-link {
+		full-duplex;
+		pause;
+		speed = <1000>;
+	};
+
+	/*
+	gmac0_mtl_rx_setup: rx-queues-config {
+		snps,rx-queues-to-use = <1>;
+		queue0 {};
+	};
+
+	gmac0_mtl_tx_setup: tx-queues-config {
+		snps,tx-queues-to-use = <1>;
+		queue0 {};
+	};
+	*/
+};
+
+// gmac1: ethernet@fe1c0000
+&gmac1 {
+	clock_in_out = "output";
+	phy-mode = "rgmii-rxid";
+	tx_delay = <0x42>;
+	pinctrl-0 = <&gmac1_miim &gmac1_tx_bus2 &gmac1_rx_bus2 &gmac1_rgmii_clk &gmac1_rgmii_bus>;
+	pinctrl-names = "default";
+	snps,reset-active-low;
+	snps,reset-delays-us = <0x00 0x4e20 0x186a0>;
+	snps,reset-gpio = <&gpio4 RK_PB3 GPIO_ACTIVE_LOW>;
+	status = "okay";
+	u-boot,dm-pre-reloc;
+
+	fixed-link {
+		full-duplex;
+		pause;
+		speed = <1000>;
+	};
+
+	/*
+	gmac1_mtl_rx_setup: rx-queues-config {
+		snps,rx-queues-to-use = <1>;
+		queue0 {};
+	};
+
+	gmac1_mtl_tx_setup: tx-queues-config {
+		snps,tx-queues-to-use = <1>;
+		queue0 {};
+	};
+	*/
+};
+
+/* ========== USB3.0 OTG/Device (Type-C) ========== */
+/* ==========================================================
+ *  USB 修复 - BYD G98
+ *  根因：SoC dtsi 中 DWC3 只绑定了 usb2-phy，缺少 usb3-phy
+ * ========================================================== */
+
+/* ====== 1. GRF/Syscon 依赖 ====== */
+&sys_grf { status = "okay"; u-boot,dm-pre-reloc; };
+&usb_grf { status = "okay"; u-boot,dm-pre-reloc; };
+&usbdpphy0_grf { status = "okay"; u-boot,dm-pre-reloc; };
+&usbdpphy1_grf { status = "okay"; u-boot,dm-pre-reloc; };
+&usb2phy0_grf { status = "okay"; u-boot,dm-pre-reloc; };
+&usb2phy1_grf { status = "okay"; u-boot,dm-pre-reloc; };
+&usb2phy2_grf { status = "okay"; u-boot,dm-pre-reloc; };
+&usb2phy3_grf { status = "okay"; u-boot,dm-pre-reloc; };
+&vo0_grf { status = "okay"; u-boot,dm-pre-reloc; };
+
+/* ====== 2. USB2 PHY ====== */
+&u2phy0 { status = "okay"; u-boot,dm-pre-reloc; };
+&u2phy0_otg {
+	phy-supply = <&vcc5v0_otg_regulator>;
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+&u2phy1 { status = "okay"; u-boot,dm-pre-reloc; };
+&u2phy1_otg {
+	phy-supply = <&vcc5v0_host_regulator>;
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+&u2phy2 { status = "okay"; u-boot,dm-pre-reloc; };
+&u2phy2_host {
+	phy-supply = <&vcc5v0_host_regulator>;
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+&u2phy3 { status = "okay"; u-boot,dm-pre-reloc; };
+&u2phy3_host {
+	phy-supply = <&vcc5v0_host_regulator>;
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+/* ====== 3. USBDP Combo PHY (USB3) ====== */
+&usbdp_phy0 {
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+&usbdp_phy0_u3 {
+	#phy-cells = <0>;
+	maximum-speed = "high-speed";
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+&usbdp_phy1 {
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+&usbdp_phy1_u3 {
+	#phy-cells = <0>;
+	maximum-speed = "high-speed";
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+/* ====== 4. DWC3 控制器 ★ 关键修复：添加 USB3 PHY 引用 ====== */
+&usbdrd3_0 {
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+&usbdrd_dwc3_0 {
+	dr_mode = "otg";
+	maximum-speed = "super-speed";
+	/* ★ 覆盖 SoC dtsi 中的 phys，同时绑定 USB2 + USB3 PHY */
+	phys = <&u2phy0_otg>, <&usbdp_phy0_u3>;
+	phy-names = "usb2-phy", "usb3-phy";
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+&usbdrd3_1 {
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+&usbdrd_dwc3_1 {
+	dr_mode = "host";
+	maximum-speed = "super-speed";
+	/* ★ 覆盖 SoC dtsi 中的 phys，同时绑定 USB2 + USB3 PHY */
+	phys = <&u2phy1_otg>, <&usbdp_phy1_u3>;
+	phy-names = "usb2-phy", "usb3-phy";
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+/* ====== 5. EHCI/OHCI (USB2.0) ====== */
+&usb_host0_ehci { status = "okay"; u-boot,dm-pre-reloc; };
+&usb_host0_ohci { status = "okay"; u-boot,dm-pre-reloc; };
+&usb_host1_ehci { status = "okay"; u-boot,dm-pre-reloc; };
+&usb_host1_ohci { status = "okay"; u-boot,dm-pre-reloc; };
+
+/* ====== 6. 禁用不用的控制器 ====== */
+&usbhost3_0 { status = "disabled"; };
+
+
+/* ====== 补充修复：强制启用 u-boot.dtsi 中遗漏的 GRF 和 PHY ====== */
+
+/* vo0_grf 是 usbdp_phy 的硬性依赖，必须 dm-pre-reloc */
+&vo0_grf {
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+/* usbdpphy1_grf 在 u-boot.dtsi 中完全缺失 */
+&usbdpphy1_grf {
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+/* usb2phy1/2/3_grf 在 u-boot.dtsi 中完全缺失 */
+&usb2phy1_grf {
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+&usb2phy2_grf {
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+&usb2phy3_grf {
+	status = "okay";
+	u-boot,dm-pre-reloc;
 };
+
+/* usbdp_phy1 及其子节点在 u-boot.dtsi 中完全缺失 */
+&usbdp_phy1 {
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+&usbdp_phy1_u3 {
+	#phy-cells = <0>;
+	maximum-speed = "high-speed";
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+/* ====== SATA 完整适配 - BYD G98 (已修正) ====== */
+
+/* pipe_phy0_grf 是 syscon，保持原始 compatible 不变 */
+&pipe_phy0_grf {
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+&php_grf {
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+&combphy0_ps {
+    pinctrl-0 = <&sata0_pm_reset>;
+    pinctrl-names = "default";
+    phy-type = <PHY_TYPE_SATA>;
+    status = "okay";
+    u-boot,dm-pre-reloc;
+    rockchip,pipe-phy-grf = <&pipe_phy0_grf>;
+};
+
+/* SATA 控制器 sata@fe210000 */
+&sata0 {
+	status = "okay";
+	phys = <&combphy0_ps PHY_TYPE_SATA>;
+	phy-names = "sata-phy";
+	u-boot,dm-pre-reloc;
+};
+
+&gpio0 {
+	status = "okay";
+	u-boot,dm-pre-reloc;
+};
+
+&pcie2x1l0 { status = "disabled"; };
+&sata1 { status = "disabled"; };
+
diff --git a/arch/arm/dts/rk3588-u-boot.dtsi b/arch/arm/dts/rk3588-u-boot.dtsi
index 8dbc5d688e..dfea11f56f 100644
--- a/arch/arm/dts/rk3588-u-boot.dtsi
+++ b/arch/arm/dts/rk3588-u-boot.dtsi
@@ -14,7 +14,7 @@
 
 	chosen {
 		stdout-path = &uart2;
-		u-boot,spl-boot-order = &sdmmc, &sdhci, &spi_nand, &spi_nor;
+		u-boot,spl-boot-order = &sdmmc, &sdhci, &spi_nand, &spi_nor, &sata1;
 	};
 
 	secure-otp@fe3a0000 {
diff --git a/configs/rk3588_defconfig b/configs/rk3588_defconfig
index fb8b752793..802c992e22 100644
--- a/configs/rk3588_defconfig
+++ b/configs/rk3588_defconfig
@@ -78,7 +78,7 @@ CONFIG_CMD_USB_MASS_STORAGE=y
 CONFIG_CMD_TFTPPUT=y
 CONFIG_CMD_TFTP_BOOTM=y
 CONFIG_CMD_TFTP_FLASH=y
-# CONFIG_CMD_MISC is not set
+CONFIG_CMD_MISC=y
 CONFIG_CMD_MTD_BLK=y
 # CONFIG_SPL_DOS_PARTITION is not set
 # CONFIG_ISO_PARTITION is not set
@@ -236,3 +236,21 @@ CONFIG_RK_AVB_LIBAVB_USER=y
 CONFIG_OPTEE_CLIENT=y
 CONFIG_OPTEE_V2=y
 CONFIG_OPTEE_ALWAYS_USE_SECURITY_PARTITION=y
+CONFIG_PCI=y
+CONFIG_CMD_PCI=y
+CONFIG_NVME=y
+CONFIG_DM_PCI=y
+CONFIG_PCIE_DW_ROCKCHIP=y
+CONFIG_CMD_NVME=y
+CONFIG_CMD_MTD=y
+CONFIG_CMD_MTD_BLK=y
+CONFIG_PHY_ROCKCHIP_SNPS_PCIE3=y
+CONFIG_SCSI=y
+CONFIG_SCSI_AHCI=y
+CONFIG_AHCI_PCI=y
+CONFIG_DM_SCSI=y
+CONFIG_CMD_SCSI=y
+CONFIG_PHY_ROCKCHIP_SATA=y
+CONFIG_PHY_ROCKCHIP_NANENG_COMBOPHY=y
+CONFIG_DWC_AHCI=y
+CONFIG_AHCI=y
diff --git a/g98-uboot.dts b/g98-uboot.dts
new file mode 100644
index 0000000000..9c37725d36
--- /dev/null
+++ b/g98-uboot.dts
@@ -0,0 +1,5515 @@
+/dts-v1/;
+
+/ {
+	compatible = "rockchip,rk3588-evb\0rockchip,rk3588";
+	interrupt-parent = <0x10000000>;
+	#address-cells = <0x02>;
+	#size-cells = <0x02>;
+	model = "BYD G98";
+
+	aliases {
+		ethernet1 = "/ethernet@fe1c0000";
+		i2c0 = "/i2c@fd880000";
+		i2c1 = "/i2c@fea90000";
+		i2c2 = "/i2c@feaa0000";
+		i2c3 = "/i2c@feab0000";
+		i2c4 = "/i2c@feac0000";
+		i2c5 = "/i2c@fead0000";
+		i2c6 = "/i2c@fec80000";
+		i2c7 = "/i2c@fec90000";
+		i2c8 = "/i2c@feca0000";
+		serial0 = "/serial@fd890000";
+		serial1 = "/serial@feb40000";
+		serial2 = "/serial@feb50000";
+		serial3 = "/serial@feb60000";
+		serial4 = "/serial@feb70000";
+		serial5 = "/serial@feb80000";
+		serial6 = "/serial@feb90000";
+		serial7 = "/serial@feba0000";
+		serial8 = "/serial@febb0000";
+		serial9 = "/serial@febc0000";
+		spi0 = "/spi@feb00000";
+		spi1 = "/spi@feb10000";
+		spi2 = "/spi@feb20000";
+		spi3 = "/spi@feb30000";
+		spi4 = "/spi@fecb0000";
+		spi5 = "/spi@fe2b0000";
+		gpio0 = "/pinctrl/gpio@fd8a0000";
+		gpio1 = "/pinctrl/gpio@fec20000";
+		gpio2 = "/pinctrl/gpio@fec30000";
+		gpio3 = "/pinctrl/gpio@fec40000";
+		gpio4 = "/pinctrl/gpio@fec50000";
+		edp0 = "/edp@fdec0000";
+		edp1 = "/edp@fded0000";
+		ethernet0 = "/ethernet@fe1b0000";
+		hdptx0 = "/phy@fed60000";
+		hdptx1 = "/phy@fed70000";
+		mmc0 = "/mmc@fe2e0000";
+		mmc1 = "/mmc@fe2c0000";
+	};
+
+	cpus {
+		#address-cells = <0x01>;
+		#size-cells = <0x00>;
+
+		cpu-map {
+
+			cluster0 {
+
+				core0 {
+					cpu = <0x10000001>;
+				};
+
+				core1 {
+					cpu = <0x10000002>;
+				};
+
+				core2 {
+					cpu = <0x10000003>;
+				};
+
+				core3 {
+					cpu = <0x10000004>;
+				};
+			};
+
+			cluster1 {
+
+				core0 {
+					cpu = <0x10000005>;
+				};
