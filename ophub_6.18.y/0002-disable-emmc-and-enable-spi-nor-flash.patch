From e17f6e77cc736f53e21ef53886e0ebbf9a7c28a2 Mon Sep 17 00:00:00 2001
From: yifengyou <842056007@qq.com>
Date: Sun, 9 Aug 2026 10:47:51 +0800
Subject: [PATCH 2/2] disable emmc and enable spi nor flash
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

默认板载SPI 32MB，没有emmc

Signed-off-by: yifengyou <842056007@qq.com>
---
 .../boot/dts/rockchip/rk3588-bdy-g98.dts      | 20 ++++++++++++++++++-
 kdev-build.sh                                 |  8 ++++++++
 2 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3588-bdy-g98.dts b/arch/arm64/boot/dts/rockchip/rk3588-bdy-g98.dts
index c5d9fe6c6..b795fa5fe 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588-bdy-g98.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588-bdy-g98.dts
@@ -432,6 +432,7 @@ sata0_pm_reset: sata0-pm-reset {
 /* ===== Storage ===== */
 
 // sdhci: mmc@fe2e0000
+// 暂时不考虑支持EMMC。因EMMC与SPI冲突，此处关闭EMMC，仅开启SPI即可
 &sdhci {
 	bus-width = <8>;
 	no-sdio;
@@ -441,7 +442,24 @@ &sdhci {
 	mmc-hs200-1_8v;
 	mmc-hs400-1_8v;
 	mmc-hs400-enhanced-strobe;
-	status = "okay";
+	status = "disabled";
+};
+
+// sfc: spi@fe2b0000
+// 开启SPI支持
+&sfc {
+	status = "okay";
+	/delete-node/ flash@1;
+	spi_nor: flash@0 {
+		compatible = "jedec,spi-nor";
+		label = "sfc_nor";
+		reg = <0x00>;
+		spi-tx-bus-width = <0x01>;
+		spi-rx-bus-width = <0x04>;
+		spi-max-frequency = <0x5f5e100>;
+		spi-4byte-addressing;
+		broken-flash-reset;
+	};
 };
 
 // sdmmc: mmc@fe2c0000
diff --git a/kdev-build.sh b/kdev-build.sh
index 264d2a4c5..05d69ad26 100755
--- a/kdev-build.sh
+++ b/kdev-build.sh
@@ -62,6 +62,14 @@ make ARCH=arm64 \
   INSTALL_MOD_PATH=$(pwd)/kos \
   modules_install
 
+make ARCH=arm64 \
+  CROSS_COMPILE=aarch64-linux-gnu- \
+  KBUILD_BUILD_USER="builder" \
+  KBUILD_BUILD_HOST="kdevbuilder" \
+  LOCALVERSION=-kdev \
+  INSTALL_HDR_PATH=$(pwd)/kernel-headers \
+  headers_install
+
 ls -alh arch/arm64/boot/dts/rockchip/rk3588-bdy-g98.dtb
 dtc -I dtb -o dts arch/arm64/boot/dts/rockchip/rk3588-bdy-g98.dtb -o dts.patch
 cat include/config/kernel.release
-- 
2.43.0

