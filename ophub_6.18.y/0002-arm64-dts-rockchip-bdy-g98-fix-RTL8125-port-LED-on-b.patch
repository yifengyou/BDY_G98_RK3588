From 5beb988c1dff4b8a853ae19d9f9bd2e68d9d05af Mon Sep 17 00:00:00 2001
From: ophub <68696949+ophub@users.noreply.github.com>
Date: Wed, 12 Aug 2026 10:41:24 +0800
Subject: [PATCH 2/4] arm64: dts: rockchip: bdy-g98: fix RTL8125 port LED on
 blank-EEPROM units

---
 .../boot/dts/rockchip/rk3588-bdy-g98.dts      | 45 ++++---------------
 1 file changed, 8 insertions(+), 37 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3588-bdy-g98.dts b/arch/arm64/boot/dts/rockchip/rk3588-bdy-g98.dts
index 02579e8ca..c5d9fe6c6 100644
--- a/arch/arm64/boot/dts/rockchip/rk3588-bdy-g98.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3588-bdy-g98.dts
@@ -326,34 +326,16 @@ &pcie2x1l0 {
 	status = "okay";
 
 	/*
-	 * Workaround for units shipped with a blank RTL8125 config EEPROM.
-	 * The chip's default LEDSEL then assigns each LED pin a single link
-	 * speed (LED1=100M, LED2=1000M, LED3=2.5G), but this board wires
-	 * its RJ45 LEDs to LED1/LED2, so they stay dark at 2.5G. Program
-	 * all four pins identically: LED on at any link speed, blink on activity.
-	 *
-	 * LEDSEL bits: 0=Link10M 1=Link100M 3=Link1000M 5=Link2.5G 9=ACT
-	 * 12=active-low (unused, this board is active-high).
-	 *
-	 * The node hierarchy must mirror the PCI topology: pcie@0,0 below
-	 * is the root port (0002:20:00.0) and ethernet@0,0 under it is the
-	 * RTL8125 endpoint (0002:21:00.0). A flat pcie@0,0 carrying the
-	 * properties directly here would be claimed by the root port
-	 * instead, because of_pci_find_child_device() matches by devfn only.
+	 * Units with a blank config EEPROM fall back to the chip's default
+	 * LEDSEL, which lacks the Link2.5G bit: the port LED only flashes
+	 * once while autoneg trains at low speed, then stays dark at 2.5G.
+	 * LEDSEL0 bits: 0=Link10M 1=Link100M 3=Link1000M 5=Link2.5G 9=ACT
+	 * 12=active-low. 0x22b = link at any speed + activity, active-high;
+	 * if the LED behaves inverted on this board use 0x122b instead.
 	 */
 	pcie@0,0 {
 		reg = <0x0000 0 0 0 0>;
-		#address-cells = <3>;
-		#size-cells = <2>;
-		ranges;
-
-		ethernet@0,0 {
-			reg = <0x0000 0 0 0 0>;
-			r8125,led0 = <0x22b>;
-			r8125,led1 = <0x22b>;
-			r8125,led2 = <0x22b>;
-			r8125,led3 = <0x22b>;
-		};
+		r8125,led0 = <0x22b>;
 	};
 };
 
@@ -366,20 +348,9 @@ &pcie2x1l1 {
 	vpcie3v3-supply = <&vcc3v3_nvme>;
 	status = "okay";
 
-	/* Same blank-EEPROM LED fix as pcie2x1l0 (endpoint 0003:31:00.0) */
 	pcie@0,0 {
 		reg = <0x0000 0 0 0 0>;
-		#address-cells = <3>;
-		#size-cells = <2>;
-		ranges;
-
-		ethernet@0,0 {
-			reg = <0x0000 0 0 0 0>;
-			r8125,led0 = <0x22b>;
-			r8125,led1 = <0x22b>;
-			r8125,led2 = <0x22b>;
-			r8125,led3 = <0x22b>;
-		};
+		r8125,led0 = <0x22b>;
 	};
 };
 
