From bfe2d63f3fa68f2d2881aa73b2b077bd4beed5f8 Mon Sep 17 00:00:00 2001
From: yifengyou <842056007@qq.com>
Date: Sun, 9 Aug 2026 10:47:51 +0800
Subject: [PATCH 4/4] disable emmc and enable spi nor flash
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

默认板载SPI 32MB，没有emmc

Signed-off-by: yifengyou <842056007@qq.com>
---
 .gitignore    | 3 +++
 kdev-build.sh | 8 ++++++++
 2 files changed, 11 insertions(+)

diff --git a/.gitignore b/.gitignore
index c535add06..ce0f36b25 100644
--- a/.gitignore
+++ b/.gitignore
@@ -185,3 +185,6 @@ sphinx_*/
 # Rust analyzer configuration
 /rust-project.json
 /kos
+/kernel-headers/
+/rk3588-bdy-g98.dts
+
diff --git a/kdev-build.sh b/kdev-build.sh
index 264d2a4c5..05d69ad26 100755
--- a/kdev-build.sh
+++ b/kdev-build.sh
@@ -62,6 +62,14 @@ make ARCH=arm64 \
   INSTALL_MOD_PATH=$(pwd)/kos \
   modules_install
 
+make ARCH=arm64 \
+  CROSS_COMPILE=aarch64-linux-gnu- \
+  KBUILD_BUILD_USER="builder" \
+  KBUILD_BUILD_HOST="kdevbuilder" \
+  LOCALVERSION=-kdev \
+  INSTALL_HDR_PATH=$(pwd)/kernel-headers \
+  headers_install
+
 ls -alh arch/arm64/boot/dts/rockchip/rk3588-bdy-g98.dtb
 dtc -I dtb -o dts arch/arm64/boot/dts/rockchip/rk3588-bdy-g98.dtb -o dts.patch
 cat include/config/kernel.release
-- 
